#######################################################################
############# Load and set optical waveguide parameters ###############
#######################################################################
clear;
matlabload('tw_modulator_optical_data');

freq = c/1.55e-6;
setnamed('WGD_1','frequency',freq);
setnamed('WGD_1','length',3.5e-3);
setnamed('WGD_1','loss 1',loss(2,2));
setnamed('WGD_1','effective index 1',neff(2,2));
setnamed('WGD_1','group index 1',ng(2,2));
setnamed('WGD_2','frequency',freq);
setnamed('WGD_2','length',3.6e-3);
setnamed('WGD_2','loss 1',loss(2,2));
setnamed('WGD_2','effective index 1',neff(2,2));
setnamed('WGD_2','group index 1',ng(2,2));

setnamed('OM_1','frequency',freq);
setnamed('OM_1','length',3.5e-3);
setnamed('OM_1','measurement',dneff);
setnamed('OM_2','frequency',freq);
setnamed('OM_2','length',3.5e-3);
setnamed('OM_2','measurement',dneff);

setnamed('TW_1','optical index',ng(2,2));

#######################################################################
############# Load and set RF transmission line parameters ############
#######################################################################
clear;
matlabload('tw_modulator_RF_data');
matlabload('tw_modulator_dc_C');
Rslab_total = str2num(read('tw_modulator_Rslab_tot.dat'));

setnamed('TW_1','length',5.e-3);
setnamed('TW_1','loss table',loss);
setnamed('TW_1','characteristic impedance table',Z0);
setnamed('TW_1','junction capacitance table',Cdc);
setnamed('TW_1','junction resistance',Rslab_total);
setnamed('TW_1','microwave index table',ng);

#######################################################################
############# Run ONA (wavelength sweep) at 0, 1, 2 V ###################
#######################################################################

bias_vals = [0, 1, 2];
gain_results = cell(3);

for(i=1:3) {
    switchtolayout;
    setnamed('DC_2','amplitude', bias_vals(i));
    run;
    
    t = getresult('ONA_1','input 1/mode 1/transmission');
    wavelength = t.wavelength;
    
    g = getresult('ONA_1','input 1/mode 1/gain');
    gain_results{i} = getattribute(g, "TE gain (dB)");
}

G0 = gain_results{1};
G1 = gain_results{2};
G2 = gain_results{3};

#######################################################################
############# Export to MATLAB ###########################################
#######################################################################
matlabsave('mzm_gain_vs_wavelength', wavelength, G0, G1, G2);