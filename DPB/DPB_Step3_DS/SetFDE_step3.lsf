addfde();

xspan_fde = 8e-6;
yspan_fde = 1e-6;
zspan_fde = 0.5e-6;
n_SiO2 = 'SiO2 (Glass) - Palik';
set('solver type' , '2D Y normal');

set("x",0);
set("x span", xspan_fde);

set("y",0);

set("z", 0.5*(pad_height + 0.5*wd_height + 0.5*pad_height ));
set("z span",zspan_fde);

set('define x mesh by', 'number of mesh cells');
set('define z mesh by', 'number of mesh cells');
set('mesh cells x', 100);
set('mesh cells z', 100);

set('x min bc', 'PML');
set('x max bc', 'PML');
set('z min bc', 'PML');
set('z max bc', 'PML');

set('index', n_SiO2);

setanalysis('wavelength',1.55e-6);
setanalysis('number of trial modes',10);
setanalysis('search','near n');
setanalysis('use max index',true);
setanalysis('calculate group index',true);


